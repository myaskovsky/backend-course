# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Auth cookies (SameSite: lax | strict | none)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=localhost

# Trusted CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080

# JWT (secrets — replace in real environments; TTL in seconds: 900=15m, 2592000=30d)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# SMTP (turboSMTP). Fill USER/PASSWORD to send real OTP emails; leave HOST blank to log codes instead.
# turboSMTP: host pro.turbo-smtp.com, port 587 (STARTTLS => SMTP_SECURE=false), or 465 with SMTP_SECURE=true.
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-turbosmtp-username
SMTP_PASSWORD=your-turbosmtp-password
# From must be a sender verified in your turboSMTP account.
SMTP_FROM=no-reply@example.com

# Email confirmation feature flags (OTP delivery wired in Phase 6)
CONFIRM_REGISTRATION_ENABLED=false
CONFIRM_LOGIN_ENABLED=false
CONFIRM_EMAIL_CHANGE_ENABLED=true
CONFIRM_SELF_DELETE_ENABLED=true
CONFIRM_PASSWORD_RECOVERY=true

# Health check (pings the database at /health)
HEALTH_CHECK_ENABLED=true

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true
